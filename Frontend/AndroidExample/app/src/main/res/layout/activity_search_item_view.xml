<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchItemView">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/vwebtoolbar1"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/cardinal"
            app:navigationIcon="?attr/homeAsUpIndicator">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:src="@drawable/baseline_rectangle_24" />

                <!-- LinearLayout inside FrameLayout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="bottom">

                    <EditText
                        android:id="@+id/searchedItem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#FFFFFF"
                        android:padding="8dp" /> <!-- Set background color to white -->

<!--                    <ImageButton-->
<!--                        android:id="@+id/searchBtn"-->

<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:src="@drawable/baseline_send_24"/>-->

                </LinearLayout>
            </FrameLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>


    <!-- RecyclerView positioned below the header -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appbar"
        tools:listitem="@layout/post_item" />


    <!-- Gold bar under the app bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@color/gold"
        android:layout_below="@id/recycler_view_search" />

    <!-- Header TextView for Friends -->
    <TextView
        android:id="@+id/header_text_view_friends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Users"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="0dp"
        android:layout_below="@id/recycler_view_search"
        android:layout_centerHorizontal="true" />

    <ListView
        android:id="@+id/list_view_users"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_text_view_friends"
        android:layout_marginTop="8dp" />





</RelativeLayout>